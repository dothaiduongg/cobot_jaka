<Window x:Class="WPF_robot_sim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều khiển Robot JAKA" Height="600" Width="900" Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        >

    <Grid>
        <!-- Scalable surface -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Background="{x:Null}">
            <Border Padding="0" Height="555" Width="890">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.LayoutTransform>

                <!-- ====== TOÀN BỘ UI GỐC CỦA BẠN BÊN DƯỚI ====== -->
                <Grid x:Name="AppRoot" Margin="5,5,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="0*"/>
                        <RowDefinition Height="327.2"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bảng điều khiển Robot JAKA" FontSize="22"
                               FontWeight="Bold" Foreground="DarkSlateBlue"
                               HorizontalAlignment="Center" Margin="0,0,0,5" Width="302"/>

                    <!-- Kết nối -->
                    <GroupBox Header="Connection" Padding="10" Margin="10,0,5,0" Height="95" VerticalAlignment="Top" Grid.Row="2">
                        <GroupBox.Resources>
                            <!-- Style nhẹ cho TextBox: bo góc, padding, watermark qua Tag -->
                            <Style TargetType="TextBox" x:Key="NiceTextBox">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="BorderBrush" Value="#B8C1D1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border CornerRadius="6"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                                <ScrollViewer Margin="6,4,6,4" x:Name="PART_ContentHost"/>
                                                <!-- Watermark -->
                                                <TextBlock Text="{TemplateBinding Tag}"
                                                           Foreground="#9aa3af"
                                                           Margin="8,6,8,6"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupBox.Resources>

                        <Grid Margin="0,0,-14,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="216.8"/>
                                <ColumnDefinition Width="Auto" MinWidth="440.8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Height="55">
                                <TextBlock Text="IP Address:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtIp"
                                         Width="152" Height="42"
                                         Style="{StaticResource NiceTextBox}"
                                         Tag="e.g. 192.168.31.226"
                                         Text="192.168.31.226"
                                         PreviewTextInput="TxtIp_PreviewTextInput"
                                         LostFocus="TxtIp_LostFocus"
                                         DataObject.Pasting="TxtIp_Pasting" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="10,0,10,0" Grid.ColumnSpan="2">
                                <!-- Style bo góc cho toàn bộ Button bên trong StackPanel -->
                                <StackPanel.Resources>
                                    <!-- Implicit style: tự áp dụng cho mọi Button trong StackPanel -->
                                    <Style TargetType="Button">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Background" Value="#FF82F0E4"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FF6BE8DC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FF52D9CC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>

                                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="Refresh" Width="80" Margin="0,0,4,0"/>
                                <Button x:Name="BtnConnect" Click="BtnConnect_Click" Content="Connect" Width="80" Margin="0,0,4,0"/>
                                <Button x:Name="BtnDisconnect" Click="BtnDisconnect_Click" Content="Disconnect" Width="80" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="btnAutoHome" Content="Auto Home" Width="80" Click="btnAutoHome_Click" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="BtnMove" Content="Move" Width="80" Click="BtnMove_Click" IsEnabled="False" Margin="0,0,4,0"/>
                            </StackPanel>


                            <TextBlock x:Name="TxtStatus" Grid.Column="2" VerticalAlignment="Center" Foreground="DarkSlateGray"
                                       Text="Status: Disconnected" Height="16" Margin="16,0,23,0"/>
                        </Grid>
                    </GroupBox>
                    <Grid Grid.Row="2" Margin="10,95,28,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="387.2" />
                            <ColumnDefinition Width="412.8"/>
                        </Grid.ColumnDefinitions>
                        <!-- JOINTS -->
                        <GroupBox Header="Joint Position " Margin="0,10,10,-1" Padding="10">
                            <Grid HorizontalAlignment="Center" Height="131">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="66"/>
                                    <ColumnDefinition Width="156.8"/>
                                    <ColumnDefinition Width="100.8"/>
                                </Grid.ColumnDefinitions>

                                <Grid.Resources>
                                    <Style TargetType="Slider" x:Key="JointSliderStyle">
                                        <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                        <Setter Property="TickFrequency" Value="5"/>
                                    </Style>
                                </Grid.Resources>

                                <!-- J1 -->
                                <TextBlock Grid.Column="0" Text="Joint 1" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ1" Grid.Row="0"
                                        Minimum="-360" Maximum="360" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,0,10,2" Grid.Column="1"/>
                                <TextBox x:Name="tbJ1" Grid.Row="0" Grid.Column="2" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ1, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J2 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="Joint 2" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ2" Grid.Row="1"
                                        Minimum="-50" Maximum="230" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,0,10,2" Grid.Column="1"/>
                                <TextBox x:Name="tbJ2" Grid.Row="1" Grid.Column="2" Margin="5,1,3,1"
                                        Text="{Binding ElementName=slJ2, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J3 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="Joint 3" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ3" Grid.Row="2"
                                        Minimum="-155" Maximum="155" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,1,10,2" Grid.Column="1" />
                                <TextBox x:Name="tbJ3" Grid.Row="2" Grid.Column="2" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ3, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J4 -->
                                <TextBlock Grid.Row="3" Grid.Column="0" Text="Joint 4" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ4" Grid.Row="2"
                                        Minimum="-85" Maximum="265" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,21,10,2" Grid.RowSpan="2" Grid.Column="1"/>
                                <TextBox x:Name="tbJ4" Grid.Row="3" Grid.Column="2" Margin="5,1,3,1"
                                        Text="{Binding ElementName=slJ4, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J5 -->
                                <TextBlock Grid.Row="4" Grid.Column="0" Text="Joint 5" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ5" Grid.Row="4"
                                        Minimum="-360" Maximum="360" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,1,10,2" Grid.Column="1" />
                                <TextBox x:Name="tbJ5" Grid.Row="4" Grid.Column="2" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ5, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                <!-- J6 -->
                                <TextBlock Grid.Row="5" Grid.Column="0" Text="Joint 6" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <Slider x:Name="slJ6" Grid.Row="5"
                                        Minimum="-360" Maximum="360" Value="0"
                                        Style="{StaticResource JointSliderStyle}" Margin="0,0,10,2" Grid.Column="1"/>
                                <TextBox x:Name="tbJ6" Grid.Row="5" Grid.Column="2" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ6, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <!-- CARTESIAN (bên phải) -->
                        <GroupBox Header="Cartesian (TCP)" Grid.Column="1" Padding="10" Margin="10,10,-47,-1">
                            <Grid Height="173">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                    <RowDefinition Height="22"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="44.8"/>
                                    <ColumnDefinition Width="151.2"/>
                                    <ColumnDefinition Width="139.2"/>
                                    <ColumnDefinition Width="80"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="Slider" x:Key="CartSliderStyle">
                                        <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                        <Setter Property="TickFrequency" Value="5"/>
                                        <EventSetter Event="Thumb.DragCompleted" Handler="CartesianSlider_DragCompleted"/>
                                        <EventSetter Event="KeyUp" Handler="CartesianSlider_KeyUp"/>
                                    </Style>
                                </Grid.Resources>



                                <TextBlock Grid.Row="0" Grid.ColumnSpan="4" Margin="10,0,-2,5"
                                     Foreground="#334155"
                                     Text="XYZ: mm   ·   RX/RY/RZ: deg"/>

                                <!-- X -->
                                <TextBlock Grid.Row="1" Text="X" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <Slider x:Name="slX" Grid.Row="1" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="5,1,3,2" Height="20" Style="{StaticResource CartSliderStyle}"/>
                                <TextBox x:Name="tbX" Grid.Row="1" Grid.Column="2"
                                    Text="{Binding ElementName=slX, Path=Value, StringFormat=F1}" Margin="5,3,3,3" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="1" Grid.Column="3" Text="mm" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center"/>

                                <!-- Y -->
                                <TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <Slider x:Name="slY" Grid.Row="2" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="5,1,3,2" Height="20"/>
                                <TextBox x:Name="tbY" Grid.Row="2" Grid.Column="2"
                                    Text="{Binding ElementName=slY, Path=Value, StringFormat=F1}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="2" Grid.Column="3" Text="mm" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center"/>

                                <!-- Z -->
                                <TextBlock Grid.Row="3" Text="Z" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <Slider x:Name="slZ" Grid.Row="3" Grid.Column="1" Minimum="-1000" Maximum="1000" Value="0"
                                    TickFrequency="10" IsSnapToTickEnabled="True" Margin="5,1,3,2" Height="20"/>
                                <TextBox x:Name="tbZ" Grid.Row="3" Grid.Column="2"
                                    Text="0.0" Margin="5,1,3,5" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" TextChanged="tbZ_TextChanged" />
                                <TextBlock Grid.Row="3" Grid.Column="3" Text="mm" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center"/>

                                <!-- RX -->
                                <TextBlock Grid.Row="4" Text="RX" VerticalAlignment="Center" Height="16"  Grid.Column="0" HorizontalAlignment="Center"/>
                                <Slider x:Name="slRX" Grid.Row="4" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="5,1,3,2"/>
                                <TextBox x:Name="tbRX" Grid.Row="4" Grid.Column="2"
                                    Text="{Binding ElementName=slRX, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="4" Grid.Column="3" Text="deg" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center"/>

                                <!-- RY -->
                                <TextBlock Grid.Row="5"  Text="RY" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <Slider x:Name="slRY" Grid.Row="5" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="5,1,3,2"/>
                                <TextBox x:Name="tbRY" Grid.Row="5" Grid.Column="2"
                                    Text="{Binding ElementName=slRY, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="5" Grid.Column="3" Text="deg" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center"/>

                                <!-- RZ -->
                                <TextBlock Grid.Row="6" Text="RZ" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center" />
                                <Slider x:Name="slRZ" Grid.Row="6" Grid.Column="1" Minimum="-180" Maximum="180" Value="0"
                                    TickFrequency="5" IsSnapToTickEnabled="True" Margin="5,1,3,2"/>
                                <TextBox x:Name="tbRZ" Grid.Row="6" Grid.Column="2"
                                    Text="{Binding ElementName=slRZ, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                                <TextBlock Grid.Row="6" Grid.Column="3
                                           " Text="deg" VerticalAlignment="Center" Height="16" HorizontalAlignment="Center" Grid.ColumnSpan="2"/>

                            </Grid>
                        </GroupBox>

                    </Grid>

                    <!-- LOG CONSOLE -->

                    <GroupBox Header="Log Console" Grid.Row="3" Margin="10,4,494,0" Height="167" VerticalAlignment="Top">
                        <DockPanel Height="139">
                            <TextBox x:Name="LogBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     Height="117" Width="318"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
