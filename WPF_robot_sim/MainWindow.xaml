<Window x:Class="WPF_robot_sim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều khiển Robot JAKA" Height="600" Width="900" Background="#f5f5f5"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        PreviewMouseWheel="Window_PreviewMouseWheel">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Zoom bar -->
            <RowDefinition Height="*"/>
            <!-- Scaled content -->
        </Grid.RowDefinitions>

        <!-- Zoom Bar -->
        <DockPanel Grid.Row="0" Background="#eef2f7" LastChildFill="False">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" DockPanel.Dock="Right" Margin="0,0,6,0">
                <TextBlock Text="Zoom" VerticalAlignment="Center" Foreground="#334155" Margin="0,0,6,0"/>
                <Button Content="−" Width="30" Height="28" Click="ZoomOut_Click" Margin="0,0,6,0"/>
                <Slider x:Name="ZoomSlider" Width="180" Minimum="0.5" Maximum="2.0" Value="1.0"
                        TickFrequency="0.1" IsSnapToTickEnabled="True"
                        ValueChanged="ZoomSlider_ValueChanged" Margin="0,0,6,0"/>
                <Button Content="+" Width="30" Height="28" Click="ZoomIn_Click" Margin="0,0,6,0"/>
                <Button Content="100%" Width="60" Height="28" Click="ZoomReset_Click"/>
            </StackPanel>
        </DockPanel>

        <!-- Scalable surface -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Background="{x:Null}">
            <Border Padding="0" Height="546" Width="890">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.LayoutTransform>

                <!-- ====== TOÀN BỘ UI GỐC CỦA BẠN BÊN DƯỚI ====== -->
                <Grid x:Name="AppRoot" Margin="20,20,54,54">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="180"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Bảng điều khiển Robot JAKA" FontSize="22"
                               FontWeight="Bold" Foreground="DarkSlateBlue"
                               HorizontalAlignment="Center" Margin="0,0,0,16"/>

                    <!-- Kết nối -->
                    <GroupBox Header="Connection" Padding="10" Margin="0,45,-45,0" Grid.RowSpan="2">
                        <GroupBox.Resources>
                            <!-- Style nhẹ cho TextBox: bo góc, padding, watermark qua Tag -->
                            <Style TargetType="TextBox" x:Key="NiceTextBox">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="BorderBrush" Value="#B8C1D1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border CornerRadius="6"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                                <ScrollViewer Margin="6,4,6,4" x:Name="PART_ContentHost"/>
                                                <!-- Watermark -->
                                                <TextBlock Text="{TemplateBinding Tag}"
                                                           Foreground="#9aa3af"
                                                           Margin="8,6,8,6"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupBox.Resources>

                        <Grid Margin="0,0,-32,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="216.8"/>
                                <ColumnDefinition Width="15.2"/>
                                <ColumnDefinition Width="Auto" MinWidth="440.8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,16,0" VerticalAlignment="Center" Height="55">
                                <TextBlock Text="IP Address:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtIp"
                                         Width="152" Height="42"
                                         Style="{StaticResource NiceTextBox}"
                                         Tag="e.g. 192.168.31.226"
                                         Text="192.168.31.226"
                                         PreviewTextInput="TxtIp_PreviewTextInput"
                                         LostFocus="TxtIp_LostFocus"
                                         DataObject.Pasting="TxtIp_Pasting" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="10,0,16,0" Grid.ColumnSpan="2">
                                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="Refresh" Width="80" Margin="0,0,4,0" Background="#FF82F0E4"/>
                                <Button x:Name="BtnConnect" Click="BtnConnect_Click" Content="Connect" Width="80" Margin="0,0,4,0" Background="#FF82F0E4"/>
                                <Button x:Name="BtnDisconnect" Click="BtnDisconnect_Click" Content="Disconnect" Width="80" IsEnabled="False" Margin="0,0,4,0" Background="#FF82F0E4"/>
                                <Button x:Name="btnAutoHome" Content="Auto Home" Width="80" Click="btnAutoHome_Click" IsEnabled="False" Margin="0,0,4,0" Background="#FF82F0E4"/>
                                <Button x:Name="BtnMove" Content="Move" Width="80" Click="BtnMove_Click" IsEnabled="False" Margin="0,0,4,0" Background="#FF82F0E4"/>
                            </StackPanel>

                            <TextBlock x:Name="TxtStatus" Grid.Column="3" VerticalAlignment="Center" Foreground="DarkSlateGray"
                                       Text="Status: Disconnected" Height="16" Margin="12,0,0,0"/>
                        </Grid>
                    </GroupBox>

                    <!-- JOINTS -->
                    <Grid Grid.Row="2" Margin="0,29,307,29">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="66"/>
                            <ColumnDefinition/>
                            <ColumnDefinition Width="128"/>
                            <ColumnDefinition Width="91"/>
                        </Grid.ColumnDefinitions>

                        <Grid.Resources>
                            <Style TargetType="Slider" x:Key="JointSliderStyle">
                                <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                <Setter Property="TickFrequency" Value="5"/>
                            </Style>
                        </Grid.Resources>

                        <!-- J1 -->
                        <TextBlock Grid.Column="0" Text="Joint 1" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ1" Grid.Row="0" Grid.Column="1"
                                Minimum="-360" Maximum="360" Value="0" LargeChange="10" SmallChange="1"
                                Style="{StaticResource JointSliderStyle}" Margin="0,0,0,1"/>
                        <TextBox x:Name="tbJ1" Grid.Row="0" Grid.Column="2" Margin="14,0,6,1"
                                 Text="{Binding ElementName=slJ1, Path=Value, StringFormat=F3}" />
                        <TextBlock Grid.Column="3" Text="[-360°, 360°]" VerticalAlignment="Center" Height="16"/>

                        <!-- J2 -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Joint 2" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ2" Grid.Column="1"
                                Minimum="-50" Maximum="230" Value="0"
                                Style="{StaticResource JointSliderStyle}" Margin="0,19,0,1" Grid.RowSpan="2"/>
                        <TextBox x:Name="tbJ2" Grid.Column="2" Margin="14,19,6,1"
                                 Text="{Binding ElementName=slJ2, Path=Value, StringFormat=F3}" Grid.RowSpan="2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="3" Text="[-50°, 230°]" VerticalAlignment="Center" Height="16"/>

                        <!-- J3 -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Joint 3" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ3" Grid.Row="2" Grid.Column="1"
                                Minimum="-155" Maximum="155" Value="0"
                                Style="{StaticResource JointSliderStyle}" Margin="0,0,0,2"/>
                        <TextBox x:Name="tbJ3" Grid.Row="2" Grid.Column="2" Margin="14,0,6,2"
                                 Text="{Binding ElementName=slJ3, Path=Value, StringFormat=F3}" />
                        <TextBlock Grid.Row="2" Grid.Column="3" Text="[-155°, 155°]" VerticalAlignment="Center" Height="16"/>

                        <!-- J4 -->
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Joint 4" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ4" Grid.Row="3" Grid.Column="1"
                                Minimum="-85" Maximum="265" Value="0"
                                Style="{StaticResource JointSliderStyle}" Margin="0,0,0,1"/>
                        <TextBox x:Name="tbJ4" Grid.Row="3" Grid.Column="2" Margin="14,0,6,1"
                                 Text="{Binding ElementName=slJ4, Path=Value, StringFormat=F3}" />
                        <TextBlock Grid.Row="3" Grid.Column="3" Text="[-85°, 265°]" VerticalAlignment="Center" Height="16"/>

                        <!-- J5 -->
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Joint 5" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ5" Grid.Row="4" Grid.Column="1"
                                Minimum="-360" Maximum="360" Value="0"
                                Style="{StaticResource JointSliderStyle}" Margin="0,2,0,2"/>
                        <TextBox x:Name="tbJ5" Grid.Row="4" Grid.Column="2" Margin="14,2,6,2"
                                 Text="{Binding ElementName=slJ5, Path=Value, StringFormat=F3}" />
                        <TextBlock Grid.Row="4" Grid.Column="3" Text="[-360°, 360°]" VerticalAlignment="Center" Height="16"/>

                        <!-- J6 -->
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="Joint 6" VerticalAlignment="Center" Margin="4,0,4,0" Height="16"/>
                        <Slider x:Name="slJ6" Grid.Row="5" Grid.Column="1"
                                Minimum="-360" Maximum="360" Value="0"
                                Style="{StaticResource JointSliderStyle}" Margin="0,1,0,0"/>
                        <TextBox x:Name="tbJ6" Grid.Row="5" Grid.Column="2" Margin="14,1,6,0"
                                 Text="{Binding ElementName=slJ6, Path=Value, StringFormat=F3}" />
                        <TextBlock Grid.Row="5" Grid.Column="3" Text="[-360°, 360°]" VerticalAlignment="Center" Height="16"/>
                    </Grid>

                    <!-- LOG CONSOLE -->
                    <GroupBox Header="Log Console" Grid.Row="2" Padding="8" Margin="0,188,307,0" Grid.RowSpan="2">
                        <DockPanel>
                            <TextBox x:Name="LogBox"
                                     IsReadOnly="True"
                                     TextWrapping="Wrap"
                                     VerticalScrollBarVisibility="Auto"
                                     AcceptsReturn="True"
                                     FontFamily="Consolas"
                                     Height="164" Width="500"/>
                        </DockPanel>
                    </GroupBox>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
