<Window x:Class="WPF_robot_sim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="JAKA Robot control" Height="700" Width="926" Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        WindowStyle="ThreeDBorderWindow"
        ResizeMode="CanResizeWithGrip"
        >

    <Grid>
        <!-- Scalable surface -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Background="{x:Null}">

            <!-- ====== TOÀN BỘ UI GỐC CỦA BẠN BÊN DƯỚI ====== -->
            <Grid x:Name="AppRoot" Margin="5,5,5,5">
                <Grid.RowDefinitions>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="0*"/>
                    <RowDefinition Height="0*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="Bảng điều khiển Robot JAKA" FontSize="20"
                               FontWeight="Bold" Foreground="DarkSlateBlue"
                               HorizontalAlignment="Center" Margin="0,0,0,5" Width="302" Grid.Row="0"/>

                <!-- Kết nối -->
                <GroupBox Header="Connection"  Margin="5,0,5,0" Height="100" VerticalAlignment="Center" Grid.Row="1" Width="auto">
                    <GroupBox.Resources>
                        <!-- Style nhẹ cho TextBox: bo góc, padding, watermark qua Tag -->
                        <Style TargetType="TextBox" x:Key="NiceTextBox">
                            <Setter Property="Padding" Value="8,6"/>
                            <Setter Property="FontSize" Value="14"/>
                            <Setter Property="BorderBrush" Value="#B8C1D1"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Setter Property="Background" Value="White"/>
                            <Setter Property="SnapsToDevicePixels" Value="True"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <Grid>
                                            <Border CornerRadius="6"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                            <ScrollViewer Margin="6,4,6,4" x:Name="PART_ContentHost"/>
                                            <!-- Watermark -->
                                            <TextBlock Text="{TemplateBinding Tag}"
                                                           Foreground="#9aa3af"
                                                           Margin="8,6,8,6"
                                                           IsHitTestVisible="False">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                                                    <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </GroupBox.Resources>

                    <Grid Margin="0,0,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" MinWidth="216.8"/>
                            <ColumnDefinition Width="Auto" MinWidth="436"/>
                            <ColumnDefinition/>
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="5,0,5,0" VerticalAlignment="Center" Height="50">
                            <TextBlock Text="IP Address:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                            <TextBox x:Name="TxtIp"
                                         Width="150" Height="42"
                                         Style="{StaticResource NiceTextBox}"
                                         Tag="e.g. 192.168.31.226"
                                         Text="192.168.31.226"
                                         PreviewTextInput="TxtIp_PreviewTextInput"
                                         LostFocus="TxtIp_LostFocus"
                                         DataObject.Pasting="TxtIp_Pasting" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5,15,5,16" Grid.ColumnSpan="2">
                            <!-- Style bo góc cho toàn bộ Button bên trong StackPanel -->
                            <StackPanel.Resources>
                                <!-- Implicit style: tự áp dụng cho mọi Button trong StackPanel -->
                                <Style TargetType="Button">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Background" Value="#FF82F0E4"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF6BE8DC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF52D9CC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </StackPanel.Resources>

                            <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="Refresh" Width="80" Margin="0,0,4,0"/>
                            <Button x:Name="BtnConnect" Click="BtnConnect_Click" Content="Connect" Width="80" Margin="0,0,4,0"/>
                            <Button x:Name="BtnDisconnect" Click="BtnDisconnect_Click" Content="Disconnect" Width="80" IsEnabled="False" Margin="0,0,4,0"/>
                            <Button x:Name="btnAutoHome" Content="Auto Home" Width="80" Click="btnAutoHome_Click" IsEnabled="False" Margin="0,0,4,0"/>
                            <Button x:Name="BtnMove" Content="Move" Width="80" Click="BtnMove_Click" IsEnabled="False" Margin="0,0,4,0"/>
                        </StackPanel>


                        <TextBlock x:Name="TxtStatus" Grid.Column="2" VerticalAlignment="Center" Foreground="DarkSlateGray"
                                       Text="Status: Disconnected" Height="16" Width="auto" Margin="5,0,9,0"/>
                    </Grid>
                </GroupBox>
                <Grid Grid.Row="2" Margin="5" Width="auto" Height="300" VerticalAlignment="Top" Grid.RowSpan="2" >
                    <Grid.RowDefinitions>
                        <RowDefinition Height="135"/>
                        <RowDefinition Height="155"/>

                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="332" />
                        <ColumnDefinition Width="auto"/>
                    </Grid.ColumnDefinitions>
                    <!-- JOINTS -->
                    <GroupBox Header="Joint Position " Margin="0,0,5,5" Grid.Row="0" Grid.Column="0">
                        <Grid HorizontalAlignment="Left" Height="75" Margin="65,0,52,0" >
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>

                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="Slider" x:Key="JointSliderStyle">
                                    <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                    <Setter Property="TickFrequency" Value="5"/>
                                </Style>
                            </Grid.Resources>

                            <!-- J1 -->
                            <TextBlock Grid.Column="0" Text="J1" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>

                            <TextBox x:Name="tbJ1" Grid.Row="0" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ1, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                            <!-- J2 -->
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="J2" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbJ2" Grid.Row="1" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ2, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                            <!-- J3 -->
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="J3" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbJ3" Grid.Row="2" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ3, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                            <!-- J4 -->
                            <TextBlock Grid.Row="0" Grid.Column="2" Text="J4" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbJ4" Grid.Row="0" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ4, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                            <!-- J5 -->
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="J5" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbJ5" Grid.Row="1" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ5, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                            <!-- J6 -->
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="J6" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbJ6" Grid.Row="2" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ6, Path=Value, StringFormat={}{0:#.#}}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                        </Grid>
                    </GroupBox>
                    <!-- CARTESIAN (bên phải) -->
                    <GroupBox Header="Cartesian (TCP)" Grid.Column="0" Margin="0,5,5,0" Grid.Row="1" >
                        <Grid Height="100" Margin="65,0,52,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                                <RowDefinition Height="25"/>
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                                <ColumnDefinition Width="30"/>
                                <ColumnDefinition Width="60"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="Slider" x:Key="CartSliderStyle">
                                    <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                    <Setter Property="TickFrequency" Value="5"/>
                                    <EventSetter Event="Thumb.DragCompleted" Handler="CartesianSlider_DragCompleted"/>
                                    <EventSetter Event="KeyUp" Handler="CartesianSlider_KeyUp"/>
                                </Style>
                            </Grid.Resources>



                            <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="10,0,-93,5"
                                     Foreground="#334155"
                                     Text="XYZ: mm   ·   RX/RY/RZ: deg"/>

                            <!-- X -->
                            <TextBlock Grid.Row="1" Text="X" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbX" Grid.Row="1" Grid.Column="1"
                                    Text="{Binding ElementName=slX, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- Y -->
                            <TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbY" Grid.Row="2" Grid.Column="1"
                                    Text="{Binding ElementName=slY, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- Z -->
                            <TextBlock Grid.Row="3" Text="Z" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbZ" Grid.Row="3" Grid.Column="1"
                                    Text="{Binding ElementName=slZ, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- RX -->
                            <TextBlock Grid.Row="1" Text="RX" VerticalAlignment="Center" Height="16"  Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbRX" Grid.Row="1" Grid.Column="3"
                                    Text="{Binding ElementName=slRX, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- RY -->
                            <TextBlock Grid.Row="2"  Text="RY" VerticalAlignment="Center" Height="16" Grid.Column="2" HorizontalAlignment="Center"/>
                            <TextBox x:Name="tbRY" Grid.Row="2" Grid.Column="3"
                                    Text="{Binding ElementName=slRY, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            <!-- RZ -->
                            <TextBlock Grid.Row="3" Text="RZ" VerticalAlignment="Center" Height="16" Grid.Column="2" HorizontalAlignment="Center" />
                            <TextBox x:Name="tbRZ" Grid.Row="3" Grid.Column="3"
                                    Text="{Binding ElementName=slRZ, Path=Value, StringFormat={}{0:#.#}}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                        </Grid>
                    </GroupBox>
                    <GroupBox Header="Record Points" Grid.Column="1" Grid.Row="0" Grid.RowSpan="2" Margin="5,0,0,0" HorizontalAlignment="Left" Width="559">
                        <Grid Margin="5">
                            <Grid.Resources>
                                <Style TargetType="Button">
                                    <Setter Property="Padding" Value="8,4"/>
                                    <Setter Property="Background" Value="#FF82F0E4"/>
                                    <Setter Property="BorderBrush" Value="Transparent"/>
                                    <Setter Property="BorderThickness" Value="0"/>
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border x:Name="bd"
                                    CornerRadius="10"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}">
                                                    <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}"
                                                  RecognizesAccessKey="True"/>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF6BE8DC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsPressed" Value="True">
                                                        <Setter TargetName="bd" Property="Background" Value="#FF52D9CC"/>
                                                    </Trigger>
                                                    <Trigger Property="IsEnabled" Value="False">
                                                        <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Grid.Resources>

                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <!-- Row 1 -->
                            <StackPanel Orientation="Horizontal" Grid.Row="0" Margin="0,5,0,5">
                                <TextBlock Text="Delay (ms):" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="tbDelay" Width="100" Text="1000" VerticalContentAlignment="Center" Margin="0,0,16,0" HorizontalContentAlignment="Center"/>
                                <TextBlock Text="Loops:" VerticalAlignment="Center" Margin="0,0,8,0"/>
                                <TextBox x:Name="tbLoops" Width="80" Text="1" VerticalContentAlignment="Center" Margin="0,0,16,0" HorizontalContentAlignment="Center"/>
                                <Button x:Name="btnAddFromCurrent" Content="Add point" Click="btnAddFromCurrent_Click" Margin="0,0,8,0"/>
                                <Button x:Name="btnUpdateFromCurrent" Content="Update point" Click="btnUpdateFromCurrent_Click"/>
                            </StackPanel>

                            <!-- Row 2 -->
                            <DataGrid x:Name="dgPoints"
                                      Grid.Row="1"
                                      ItemsSource="{Binding Points}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      IsReadOnly="False"
                                      SelectionMode="Extended"
                                      HeadersVisibility="Column"
                                      Margin="0,0,0,8">
                                <DataGrid.Resources>
                                    <!-- Center text in cells (display + editing) -->
                                    <Style x:Key="CellTextCenter" TargetType="TextBlock">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                        <Setter Property="HorizontalAlignment" Value="Stretch"/>
                                    </Style>
                                    <Style x:Key="EditTextCenter" TargetType="TextBox">
                                        <Setter Property="TextAlignment" Value="Center"/>
                                    </Style>
                                    <!-- Center column headers -->
                                    <Style TargetType="DataGridColumnHeader">
                                        <Setter Property="HorizontalContentAlignment" Value="Center"/>
                                    </Style>
                                </DataGrid.Resources>

                                <DataGrid.Columns>
                                    <DataGridTextColumn Binding="{Binding Name, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Header="Name" Width="*"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J1, Mode=TwoWay}" Header="J1" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J2, Mode=TwoWay}" Header="J2" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J3, Mode=TwoWay}" Header="J3" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J4, Mode=TwoWay}" Header="J4" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J5, Mode=TwoWay}" Header="J5" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding J6, Mode=TwoWay}" Header="J6" Width="60"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                    <DataGridTextColumn Binding="{Binding DelayMs, Mode=TwoWay}" Header="Delay (ms)" Width="80"
                            ElementStyle="{StaticResource CellTextCenter}"
                            EditingElementStyle="{StaticResource EditTextCenter}"/>
                                </DataGrid.Columns>
                            </DataGrid>


                            <!-- Row 3 -->
                            <StackPanel Orientation="Horizontal" Grid.Row="2">
                                <Button Content="↑" Width="40" Margin="0,0,6,0" Click="btnUp_Click"/>
                                <Button Content="↓" Width="40" Margin="0,0,15,0" Click="btnDown_Click"/>
                                <Button Content="Delete" Margin="0,0,10,0" Click="btnRemove_Click"/>
                                <Button x:Name="btnRun" Content="Run Loop" Margin="0,0,10,0" Click="btnRun_Click"/>
                                <Button x:Name="btnStopRun" Content="Stop" Margin="0,0,20,0" Click="btnStopRun_Click" IsEnabled="False"/>
                                <Button Content="Save Config…" Margin="0,0,10,0" Click="btnSaveConfig_Click"/>
                                <Button Content="Load Config…" Click="btnLoadConfig_Click"/>
                            </StackPanel>
                        </Grid>
                    </GroupBox>

                </Grid>

                <!-- LOG CONSOLE -->
                <Grid Grid.Row="3" Margin="4,304,2,0" Height="226" VerticalAlignment="Top" Grid.Column="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <GroupBox Header="Log Console" Margin="0" Height="225" VerticalAlignment="Center">
                        <DockPanel Height="172" Margin="5,0,5,0">
                            <TextBox x:Name="LogBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas" Width="295" Height="157" Margin="5"/>
                        </DockPanel>
                    </GroupBox>

                </Grid>
            </Grid>
        </ScrollViewer>
    </Grid>
</Window>
