<Window x:Class="WPF_robot_sim.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Điều khiển Robot JAKA" Height="600" Width="900" Background="White"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="Auto"
        >

    <Grid>
        <!-- Scalable surface -->
        <ScrollViewer Grid.Row="1"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      CanContentScroll="False"
                      Background="{x:Null}">
            <Border Padding="0" Height="auto" Width="auto">
                <Border.LayoutTransform>
                    <ScaleTransform x:Name="RootScale" ScaleX="1.0" ScaleY="1.0"/>
                </Border.LayoutTransform>

                <!-- ====== TOÀN BỘ UI GỐC CỦA BẠN BÊN DƯỚI ====== -->
                <Grid x:Name="AppRoot" Margin="5,5,5,5">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>

                        <RowDefinition Height="0*"/>
                        <RowDefinition Height="327.2"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>

                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Bảng điều khiển Robot JAKA" FontSize="20"
                               FontWeight="Bold" Foreground="DarkSlateBlue"
                               HorizontalAlignment="Center" Margin="0,0,0,5" Width="302"/>

                    <!-- Kết nối -->
                    <GroupBox Header="Connection"  Margin="5,5,5,5" Height="95" VerticalAlignment="Top" Grid.Row="2">
                        <GroupBox.Resources>
                            <!-- Style nhẹ cho TextBox: bo góc, padding, watermark qua Tag -->
                            <Style TargetType="TextBox" x:Key="NiceTextBox">
                                <Setter Property="Padding" Value="8,6"/>
                                <Setter Property="FontSize" Value="14"/>
                                <Setter Property="BorderBrush" Value="#B8C1D1"/>
                                <Setter Property="BorderThickness" Value="1"/>
                                <Setter Property="Background" Value="White"/>
                                <Setter Property="SnapsToDevicePixels" Value="True"/>
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <Grid>
                                                <Border CornerRadius="6"
                                                        Background="{TemplateBinding Background}"
                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                        BorderThickness="{TemplateBinding BorderThickness}"/>
                                                <ScrollViewer Margin="6,4,6,4" x:Name="PART_ContentHost"/>
                                                <!-- Watermark -->
                                                <TextBlock Text="{TemplateBinding Tag}"
                                                           Foreground="#9aa3af"
                                                           Margin="8,6,8,6"
                                                           IsHitTestVisible="False">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Visibility" Value="Collapsed"/>
                                                            <Style.Triggers>
                                                                <MultiDataTrigger>
                                                                    <MultiDataTrigger.Conditions>
                                                                        <Condition Binding="{Binding Text, RelativeSource={RelativeSource TemplatedParent}}" Value=""/>
                                                                        <Condition Binding="{Binding IsKeyboardFocused, RelativeSource={RelativeSource TemplatedParent}}" Value="False"/>
                                                                    </MultiDataTrigger.Conditions>
                                                                    <Setter Property="Visibility" Value="Visible"/>
                                                                </MultiDataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Grid>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </GroupBox.Resources>

                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" MinWidth="216.8"/>
                                <ColumnDefinition Width="Auto" MinWidth="440.8"/>
                                <ColumnDefinition/>
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="5" VerticalAlignment="Center" Height="55">
                                <TextBlock Text="IP Address:" Margin="0,0,6,0" VerticalAlignment="Center"/>
                                <TextBox x:Name="TxtIp"
                                         Width="152" Height="42"
                                         Style="{StaticResource NiceTextBox}"
                                         Tag="e.g. 192.168.31.226"
                                         Text="192.168.31.226"
                                         PreviewTextInput="TxtIp_PreviewTextInput"
                                         LostFocus="TxtIp_LostFocus"
                                         DataObject.Pasting="TxtIp_Pasting" />
                            </StackPanel>

                            <StackPanel Orientation="Horizontal" Grid.Column="1" Margin="5" Grid.ColumnSpan="2" Height="40">
                                <!-- Style bo góc cho toàn bộ Button bên trong StackPanel -->
                                <StackPanel.Resources>
                                    <!-- Implicit style: tự áp dụng cho mọi Button trong StackPanel -->
                                    <Style TargetType="Button">
                                        <Setter Property="Padding" Value="8,4"/>
                                        <Setter Property="Background" Value="#FF82F0E4"/>
                                        <Setter Property="BorderBrush" Value="Transparent"/>
                                        <Setter Property="BorderThickness" Value="0"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="Button">
                                                    <Border x:Name="bd"
                                CornerRadius="10"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                                                        <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"
                                              RecognizesAccessKey="True"/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FF6BE8DC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsPressed" Value="True">
                                                            <Setter TargetName="bd" Property="Background" Value="#FF52D9CC"/>
                                                        </Trigger>
                                                        <Trigger Property="IsEnabled" Value="False">
                                                            <Setter TargetName="bd" Property="Opacity" Value="0.6"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </StackPanel.Resources>

                                <Button x:Name="BtnRefresh" Click="BtnRefresh_Click" Content="Refresh" Width="80" Margin="0,0,4,0"/>
                                <Button x:Name="BtnConnect" Click="BtnConnect_Click" Content="Connect" Width="80" Margin="0,0,4,0"/>
                                <Button x:Name="BtnDisconnect" Click="BtnDisconnect_Click" Content="Disconnect" Width="80" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="btnAutoHome" Content="Auto Home" Width="80" Click="btnAutoHome_Click" IsEnabled="False" Margin="0,0,4,0"/>
                                <Button x:Name="BtnMove" Content="Move" Width="80" Click="BtnMove_Click" IsEnabled="False" Margin="0,0,4,0"/>
                            </StackPanel>


                            <TextBlock x:Name="TxtStatus" Grid.Column="2" VerticalAlignment="Center" Foreground="DarkSlateGray"
                                       Text="Status: Disconnected" Height="16" Margin="10,0,23,0"/>
                        </Grid>
                    </GroupBox>
                    <Grid Grid.Row="2" Margin="10,100,28,132" Grid.RowSpan="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="135"/>
                            <RowDefinition Height="155"/>

                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="234.4" />
                            <ColumnDefinition Width="405.6"/>
                        </Grid.ColumnDefinitions>
                        <!-- JOINTS -->
                        <GroupBox Header="Joint Position " Margin="10,10,10,10" Grid.Row="0" Grid.Column="0">
                            <Grid HorizontalAlignment="Left" Height="75" >
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>

                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="Slider" x:Key="JointSliderStyle">
                                        <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                        <Setter Property="TickFrequency" Value="5"/>
                                    </Style>
                                </Grid.Resources>

                                <!-- J1 -->
                                <TextBlock Grid.Column="0" Text="J1" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>

                                <TextBox x:Name="tbJ1" Grid.Row="0" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ1, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J2 -->
                                <TextBlock Grid.Row="1" Grid.Column="0" Text="J2" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbJ2" Grid.Row="1" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ2, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J3 -->
                                <TextBlock Grid.Row="2" Grid.Column="0" Text="J3" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbJ3" Grid.Row="2" Grid.Column="1" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ3, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J4 -->
                                <TextBlock Grid.Row="0" Grid.Column="2" Text="J4" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbJ4" Grid.Row="0" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ4, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>

                                <!-- J5 -->
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="J5" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbJ5" Grid.Row="1" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ5, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center" />

                                <!-- J6 -->
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="J6" VerticalAlignment="Center" Margin="4,0,3,0" Height="16" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbJ6" Grid.Row="2" Grid.Column="3" Margin="5,1,3,2"
                                        Text="{Binding ElementName=slJ6, Path=Value, StringFormat=F3}" VerticalContentAlignment="Center" HorizontalContentAlignment="Center"/>
                            </Grid>
                        </GroupBox>
                        <!-- CARTESIAN (bên phải) -->
                        <GroupBox Header="Cartesian (TCP)" Grid.Column="0" Margin="10,10,10,10" Grid.Row="1" >
                            <Grid Height="100">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                    <RowDefinition Height="25"/>
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="60"/>
                                    <ColumnDefinition Width="30"/>
                                    <ColumnDefinition Width="60"/>
                                </Grid.ColumnDefinitions>
                                <Grid.Resources>
                                    <Style TargetType="Slider" x:Key="CartSliderStyle">
                                        <Setter Property="IsSnapToTickEnabled" Value="True"/>
                                        <Setter Property="TickFrequency" Value="5"/>
                                        <EventSetter Event="Thumb.DragCompleted" Handler="CartesianSlider_DragCompleted"/>
                                        <EventSetter Event="KeyUp" Handler="CartesianSlider_KeyUp"/>
                                    </Style>
                                </Grid.Resources>



                                <TextBlock Grid.Row="0" Grid.ColumnSpan="2" Margin="10,0,-93,5"
                                     Foreground="#334155"
                                     Text="XYZ: mm   ·   RX/RY/RZ: deg"/>

                                <!-- X -->
                                <TextBlock Grid.Row="1" Text="X" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbX" Grid.Row="1" Grid.Column="1"
                                    Text="{Binding ElementName=slX, Path=Value, StringFormat=F1}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                <!-- Y -->
                                <TextBlock Grid.Row="2" Text="Y" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbY" Grid.Row="2" Grid.Column="1"
                                    Text="{Binding ElementName=slY, Path=Value, StringFormat=F1}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                <!-- Z -->
                                <TextBlock Grid.Row="3" Text="Z" VerticalAlignment="Center" Height="16" Grid.Column="0" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbZ" Grid.Row="3" Grid.Column="1"
                                    Text="{Binding ElementName=slZ, Path=Value, StringFormat=F1}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                <!-- RX -->
                                <TextBlock Grid.Row="1" Text="RX" VerticalAlignment="Center" Height="16"  Grid.Column="2" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbRX" Grid.Row="1" Grid.Column="3"
                                    Text="{Binding ElementName=slRX, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                <!-- RY -->
                                <TextBlock Grid.Row="2"  Text="RY" VerticalAlignment="Center" Height="16" Grid.Column="2" HorizontalAlignment="Center"/>
                                <TextBox x:Name="tbRY" Grid.Row="2" Grid.Column="3"
                                    Text="{Binding ElementName=slRY, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                                <!-- RZ -->
                                <TextBlock Grid.Row="3" Text="RZ" VerticalAlignment="Center" Height="16" Grid.Column="2" HorizontalAlignment="Center" />
                                <TextBox x:Name="tbRZ" Grid.Row="3" Grid.Column="3"
                                    Text="{Binding ElementName=slRZ, Path=Value, StringFormat=F2}" Margin="5,1,3,2" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" />

                            </Grid>
                        </GroupBox>

                    </Grid>

                    <!-- LOG CONSOLE -->
                    <Grid Grid.Row="2" Margin="10,0,20,2" Height="126" VerticalAlignment="Bottom" Grid.ColumnSpan="2" Grid.RowSpan="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition/>

                        </Grid.ColumnDefinitions>
                        <GroupBox Header="Log Console" Grid.Column="1" Margin="10,0,10,0" Height="107" VerticalAlignment="Center">
                            <DockPanel Height="139">
                                <TextBox x:Name="LogBox"
                                         IsReadOnly="True"
                                         TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto"
                                         AcceptsReturn="True"
                                         FontFamily="Consolas" Width="331" Height="58"/>
                            </DockPanel>
                        </GroupBox>

                    </Grid>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</Window>
